package com.teknikservis;

import java.util.HashMap;
import java.util.PriorityQueue;
import java.util.Stack;

// Yedek Parça Düğüm Yapısı (BST)
class ParcaNode {
    String parcaKodu;
    int stokAdedi;
    ParcaNode sol, sag;

    public ParcaNode(String parcaKodu, int stokAdedi) {
        this.parcaKodu = parcaKodu;
        this.stokAdedi = stokAdedi;
        sol = sag = null;
    }
}

// İkili Arama Ağacı (BST) - Stok Yönetimi
class StokAgaci {
    ParcaNode kok;

    public void ekle(String parcaKodu, int stokAdedi) {
        kok = ekleRecursive(kok, parcaKodu, stokAdedi);
    }

    private ParcaNode ekleRecursive(ParcaNode current, String parcaKodu, int stokAdedi) {
        if (current == null) {
            return new ParcaNode(parcaKodu, stokAdedi);
        }
        if (parcaKodu.compareTo(current.parcaKodu) < 0) {
            current.sol = ekleRecursive(current.sol, parcaKodu, stokAdedi);
        } else if (parcaKodu.compareTo(current.parcaKodu) > 0) {
            current.sag = ekleRecursive(current.sag, parcaKodu, stokAdedi);
        }
        return current;
    }
}

public class Main {
    public static void main(String[] args) {
        System.out.println("=== VY-023 TEKNİK SERVİS VE BAKIM TAKİP SİSTEMİ ==_\n");

        // 1. Müşteri ve Cihaz Yönetimi (HashMap)
        HashMap<String, String> musteriMap = new HashMap<>();
        musteriMap.put("5551234567", "Ahsen Türkoğlu - Laptop");
        musteriMap.put("5559876543", "Kemal Kaplan - Telefon");
        
        System.out.println("[HashMap] Müşteri Arama Testi:");
        System.out.println("Bulunan: " + musteriMap.get("5551234567"));
        System.out.println();

        // 2. Servis Kabul ve Sıra (PriorityQueue)
        PriorityQueue<String> servisSira = new PriorityQueue<>();
        servisSira.add("2 - Normal Bakım: Fan Temizliği");
        servisSira.add("1 - Acil Onarım: Ekran Değişimi");
        
        System.out.println("[PriorityQueue] Sıradaki Servis Testi:");
        System.out.println("İşleme Alınan: " + servisSira.poll());
        System.out.println();

        // 3. Yedek Parça Stok Takibi (BST)
        StokAgaci stokAgaci = new StokAgaci();
        stokAgaci.ekle("P100", 15);
        stokAgaci.ekle("P050", 8);
        stokAgaci.ekle("P200", 25);
        
        System.out.println("[BST] Yedek Parça Stok Ağacı oluşturuldu ve parçalar eklendi.");
        System.out.println();

        // 4. İşlem Geçmişi (Stack)
        Stack<String> islemGecmisi = new Stack<>();
        islemGecmisi.push("Müşteri Kaydı Eklendi");
        islemGecmisi.push("Cihaz Servise Alındı");
        
        System.out.println("[Stack] İşlem Geçmişi Testi:");
        System.out.println("Geri Alınacak Son İşlem: " + islemGecmisi.pop());
    }
}
